---
import { withBase } from '../../utils/withBase';
import DesktopPanel from '../../components/DesktopPanel.astro';
import Site from '../../layouts/Site.astro';
import Menu from '../../components/Menu.astro';
---
<Site title={"Our work \u2014 The Grey | cre-ation"} description={"Explore cre-ation\u2019s work for The Grey: products, customer experience and customer acquisition."}>
<main id="top">
<section class="panel" id="execution"><DesktopPanel id="execution" /><div class="slide-art" style="--art-ratio: 941 / 1672; --art-width: 56.27990svh"><img src={withBase('/assets/work/00-our-work-the-grey.jpeg')} width="941" height="1672" loading="eager" decoding="async" fetchpriority="high" alt="Our work with The Grey: select brand ambassadors, talk to customers, remove products, refine website and UX, create The Grey Routine, and build an acquisition funnel."><a class="work-section-link" style="top:25.1%" href="#brand-ambassadors" aria-label="01. Select Brand Ambassadors"></a><a class="work-section-link" style="top:31.3%" href="#talk-to-customers" aria-label="02. Talk to Customers"></a><a class="work-section-link" style="top:37.7%" href="#remove-products" aria-label="03. Remove Products"></a><a class="work-section-link" style="top:44.3%" href="#website-ux" aria-label="04. Refine Website &amp; UX"></a><a class="work-section-link" style="top:50.5%" href="#the-grey-routine" aria-label="05. Create The Grey Routine"></a><a class="work-section-link" style="top:57.0%" href="#customer-acquisition" aria-label="06. Build Acquisition Funnel"></a></div></section>
<section class="panel" id="brand-ambassadors"><DesktopPanel id="brand-ambassadors" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/work/01-brand-ambassadors.jpeg')} width="864" height="1536" loading="eager" decoding="async" alt="01. Select brand ambassadors. Choose 5 to 10 people who love The Grey products and engage their audiences in skincare conversations."></div></section>
<section class="panel" id="talk-to-customers"><DesktopPanel id="talk-to-customers" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/work/02-talk-to-customers.jpeg')} width="864" height="1536" loading="eager" decoding="async" alt="02. Talk to customers. Weekly conversations to understand skin goals, struggles, expectations and experiences with The Grey."></div></section>
<section class="panel" id="remove-products"><DesktopPanel id="remove-products" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/work/03-remove-products.jpeg')} width="864" height="1536" loading="eager" decoding="async" alt="03. Remove products. Focus on the five products responsible for 80% of revenue."></div></section>
<section class="panel" id="website-ux"><DesktopPanel id="website-ux" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/work/04-website-ux.jpeg')} width="864" height="1536" loading="eager" decoding="async" alt="04. Refine website and UX. Clear value propositions, benefits, useful information and an easier path to purchase."></div></section>
<section class="panel" id="the-grey-routine"><DesktopPanel id="the-grey-routine" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/work/05-the-grey-routine.jpeg')} width="864" height="1536" loading="eager" decoding="async" alt="05. The Grey Routine. A complete, simple, educational and repeatable skincare routine."></div></section>
<section class="panel" id="customer-acquisition"><DesktopPanel id="customer-acquisition" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/work/06-customer-acquisition.jpeg')} width="864" height="1536" loading="eager" decoding="async" alt="06. Customer acquisition. Attract, educate, convert, retain and refer through ambassadors, social media, education, a skin test, personalised routines and community."></div></section>
<footer class="contact-band"><a href={withBase('/')}><span>BACK HOME.</span><small>CRE-ATION</small></a></footer></main><Menu />
</Site>
