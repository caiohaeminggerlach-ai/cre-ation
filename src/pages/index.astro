---
import { withBase } from '../utils/withBase';
import DesktopPanel from '../components/DesktopPanel.astro';
import Site from '../layouts/Site.astro';
import HomeMenu from '../components/HomeMenu.astro';
---
<Site title={"cre-ation \u2014 We create what people love"} description={"Cre-ation is a creative company improving products, customer experiences and communication."}>
<main id="top">
    <section class="panel" id="home"><DesktopPanel id="home" /><div class="slide-art" style="--art-ratio: 942 / 1672; --art-width: 56.33971svh"><img src={withBase('/assets/01-hero.png')} alt="Cre-ation. We create what people love." width="942" height="1672" fetchpriority="high"><a class="work-hit" href={withBase('/work/')} aria-label="Discover our work"></a><div class="process-strip" aria-label="Creativity leads to action, measurement and iteration"><span class="process-stage" style="--delay:0s">Creativity</span><span class="process-arrow" style="--delay:.8s" aria-hidden="true">→</span><span class="process-stage" style="--delay:1.6s">Action</span><span class="process-arrow" style="--delay:2.4s" aria-hidden="true">→</span><span class="process-stage" style="--delay:3.2s">Measurement</span><span class="process-arrow" style="--delay:4s" aria-hidden="true">→</span><span class="process-stage" style="--delay:4.8s">Iteration</span></div></div></section>
    <section class="panel" id="system"><DesktopPanel id="system" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/02-system.jpeg')} alt="We turn imagination into reality, reality into data, and data into better ideas." width="864" height="1536" loading="eager" decoding="async"></div></section>
    <section class="panel" id="not-marketing"><DesktopPanel id="not-marketing" /><div class="slide-art" style="--art-ratio: 1024 / 1536; --art-width: 66.66667svh"><img src={withBase('/assets/03-not-marketing-updated.png')} alt="We are not a marketing agency. We don’t manufacture demand. We create businesses, products &amp; experiences people genuinely love — and want to talk about. Marketing can’t save a bad product. So we look at the whole business: product, customer experience, communication." width="1024" height="1536" loading="eager"></div></section>
    <section class="panel" id="what-we-do"><DesktopPanel id="what-we-do" /><div class="slide-art" style="--art-ratio: 1024 / 1536; --art-width: 66.66667svh"><img src={withBase('/assets/04-businesses-better.jpeg')} alt="We make businesses better. Better products. Better customer experiences. Better ways to discover and talk about them. Product, customer experience, communication. Looks great. Means something. Performs. We bridge creativity and performance — because how something looks and feels matters, and so do the results." width="1024" height="1536" loading="eager"></div></section>
    <section class="panel" id="metrics"><DesktopPanel id="metrics" /><div class="slide-art" style="--art-ratio: 1024 / 1536; --art-width: 66.66667svh"><img src={withBase('/assets/05-metrics-growth.jpeg')} alt="Three metrics. One goal: growth. Acquisition: turn attention into customers. Retention: give them a reason to stay. Referral: create something worth recommending. Acquire, retain, refer, repeat." width="1024" height="1536" loading="eager"></div></section>
    <section class="panel" id="model"><DesktopPanel id="model" /><div class="slide-art" style="--art-ratio: 864 / 1536; --art-width: 56.25000svh"><img src={withBase('/assets/04-model.jpeg')} alt="No retainer. Our incentives are aligned with yours." width="864" height="1536" loading="eager" decoding="async"></div></section>
    <section class="panel theme-invert" id="conclusion"><DesktopPanel id="conclusion" /><div class="slide-art" style="--art-ratio: 1024 / 1536; --art-width: 66.66667svh"><img src={withBase('/assets/12-conclusion-clean.png')} alt="The beautiful underlying system: creativity, action, measurement and iteration." width="1024" height="1536" loading="eager"></div></section>
    <footer class="contact-band"><a href={withBase('/contact/')}><span>LET'S TALK.</span><small>CONTACT</small></a></footer>
  </main>
  <HomeMenu />
</Site>
