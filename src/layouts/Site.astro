---
import '../styles/site.css';
import '../styles/responsive.css';
import '../styles/desktop.css';
interface Props { title: string; description: string; contact?: boolean }
const { title, description, contact = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content={contact ? '#050505' : '#f7f7f5'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23000'/%3E%3Ccircle cx='11' cy='12' r='6' fill='%23fff'/%3E%3Ccircle cx='21.5' cy='10' r='4.5' fill='%23fff'/%3E%3Ccircle cx='20' cy='22' r='6' fill='%23fff'/%3E%3C/svg%3E">
  </head>
  <body class:list={{ 'contact-page': contact }}>
    <slot />
    <script>import '../scripts/site.js';</script>
  </body>
</html>
